#!/bin/sh
# Inspect the hardware path after /init has mounted the virtual filesystems.
fail() { echo "HARDWARE_FAILED: $*"; exit 1; }
grep -q '^processor[[:space:]]*:' /proc/cpuinfo || fail cpu
grep -q '^MemTotal:' /proc/meminfo || fail memory
grep -q 'System RAM' /proc/iomem || fail memory-map
grep -q 'LOC:' /proc/interrupts || fail local-apic
[ -r /sys/devices/system/cpu/online ] || fail online-cpus
[ -r /sys/firmware/acpi/tables/DSDT ] || fail acpi
echo "Online CPUs: $(cat /sys/devices/system/cpu/online)"
grep '^MemTotal:' /proc/meminfo
echo 'ACPI DSDT: available'
echo 'Interrupt controller: active'
case " $(cat /proc/cmdline) " in
    *' neko.state=required '*)
        state_device=/dev/vda
        case " $(cat /proc/cmdline) " in
            *' neko.system=required '*)
                [ -b /dev/vda ] || fail system-disk
                grep -q '^/dev/vda / ext4 ' /proc/mounts || fail system-root
                echo 'System root: /dev/vda mounted as ext4 at /'
                state_device=/dev/vdb
                ;;
        esac
        [ -b "$state_device" ] || fail virtio-block
        grep -q "^$state_device /state ext4 " /proc/mounts || fail ext4
        echo "Virtual storage: $state_device mounted as ext4 at /state"
        ;;
    *) echo 'Virtual storage: temporary RAM session' ;;
esac
echo 'HARDWARE_READY'
